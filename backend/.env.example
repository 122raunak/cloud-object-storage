# MongoDB
MONGO_URI=mongodb://mongodb:27017/auth_db
STORAGE_MONGO_URI=mongodb://mongodb:27017/storage_db

# Auth Service
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
AUTH_SERVICE_PORT=5001

# API Gateway
GATEWAY_PORT=5000
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
NODE_ENV=development

# PostgreSQL
POSTGRES_HOST=your host
POSTGRES_PORT=5432
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your password
POSTGRES_DB=metering_db

# MinIO
MINIO_ROOT_USER=your user
MINIO_ROOT_PASSWORD=password
MINIO_ENDPOINT=minio
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_PUBLIC_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=uploads
MINIO_SECRET_KEY=your_Secret_key
MINIO_ACCESS_KEY=your_access_key

#storage service
STORAGE_SERVICE_PORT=5002
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/png,image/jpeg,application/pdf
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,mp4,docx
PRESIGNED_URL_EXPIRY=300
USER_STORAGE_QUOTA=5368709120

# Metering Service
METERING_SERVICE_PORT=5003
PORT=5003

# Service URLs
AUTH_SERVICE_URL=http://auth-service:5001
STORAGE_SERVICE_URL=http://storage-service:5002
METERING_SERVICE_URL=http://metering-service:5003
BILLING_SERVICE_URL=http://billing-service:5004


REDIS_HOST=your redist host
REDIS_PORT=6379